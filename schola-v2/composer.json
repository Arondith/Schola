{
  "name": "arondith/schola-v2",
  "type": "project",
  "description": "Production-oriented study platform built with Laravel, Livewire, Alpine.js and AWS-ready infrastructure.",
  "license": "MIT",
  "require": {
    "php": "^8.4.1",
    "laravel/framework": "^13.0",
    "livewire/livewire": "^4.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "predis/predis": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test",
    "lint": "@php ./vendor/bin/pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
